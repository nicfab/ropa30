    "registro-trattamenti",
    "uropa"
  ],
  "scripts": {
    "build:css": "tailwindcss -i src/tailwind.css -o public/css/ropa30.css --minify",
    "watch:css": "tailwindcss -i src/tailwind.css -o public/css/ropa30.css --watch",
    "serve": "python3 -m http.server 8000 --directory public",
    "dev": "echo 'Run: npm run watch:css (in one terminal) and npm run serve (in another)'"
  },
  "devDependencies": {
    "@alpinejs/csp": "^3.15.12",
