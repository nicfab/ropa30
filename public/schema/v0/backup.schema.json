{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ropa30.eu/schema/v0/backup.schema.json",
  "$comment": "ROPA30 data specification. SPDX-License-Identifier: AGPL-3.0-or-later. Copyright (C) Nicola Fabiano.",
  "title": "ROPA30 - backup file (plain)",
  "description": "Complete, unencrypted backup of a ROPA30 register: export format 1, data model 5. The file is a faithful dump of the three stores (settings, processing activities, audit log), with no filtering or transformation. Backups produced by earlier versions with an older data model are migrated by the application on restore and are outside the scope of this schema. Not expressible in JSON Schema and checked by the test suite: each value in _meta.counts equals the length of the corresponding list in data.",
  "x-spec-version": "0.2.0-draft",
  "type": "object",
  "properties": {
    "_meta": {
      "type": "object",
      "description": "Information about the backup.",
      "properties": {
        "app": {
          "const": "ropa30",
          "description": "Producing application."
        },
        "exportFormatVersion": {
          "const": 1,
          "description": "Version of the backup format (evolves independently of the data model)."
        },
        "appVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+].*)?$",
          "description": "Version of the application that produced the file (semantic versioning)."
        },
        "schemaVersion": {
          "const": 5,
          "description": "Version of the data model of the records in 'data'."
        },
        "exportedAt": {
          "$ref": "common.schema.json#/$defs/dateTime",
          "description": "When the backup was produced."
        },
        "counts": {
          "type": "object",
          "description": "Number of items in each list of 'data'.",
          "properties": {
            "settings": {
              "type": "integer",
              "minimum": 0
            },
            "processingActivities": {
              "type": "integer",
              "minimum": 0
            },
            "auditLog": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "settings",
            "processingActivities",
            "auditLog"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "app",
        "exportFormatVersion",
        "appVersion",
        "schemaVersion",
        "exportedAt",
        "counts"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "description": "Content of the register.",
      "properties": {
        "settings": {
          "type": "array",
          "items": {
            "$ref": "settings.schema.json"
          },
          "description": "Register settings (normally one item)."
        },
        "processingActivities": {
          "type": "array",
          "items": {
            "$ref": "processing-activity.schema.json"
          },
          "description": "Processing activities."
        },
        "auditLog": {
          "type": "array",
          "items": {
            "$ref": "audit-entry.schema.json"
          },
          "description": "Activity log."
        }
      },
      "required": [
        "settings",
        "processingActivities",
        "auditLog"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "_meta",
    "data"
  ],
  "additionalProperties": false
}
